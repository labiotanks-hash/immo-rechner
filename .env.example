# Wird von deploy/einrichten.sh angelegt und ergänzt. Liegt nur auf dem Server, nie im Repo.

# ── Pflicht ─────────────────────────────────────────────────────────────────
# Schlüssel aus platform.claude.com → API Keys (eigener Schlüssel nur für diese App)
ANTHROPIC_API_KEY=
# Zufallswert für die Anmelde-Cookies: openssl rand -hex 32
SESSION_SECRET=
DOMAIN=immo-rechner.a2o-architekten.de
PUBLIC_URL=https://immo-rechner.a2o-architekten.de

# ── Anmeldung wie BauDoc (Supabase-Projekt „hilfezumselberbauen“) ────────────
# Öffentliche Werte (stehen auch im Browser). NIE den service_role-Key eintragen.
SUPABASE_URL=https://mispnnkryqemhvngopnx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_C4Tb1Bkj0WOk7JuNDuSS2g_IFaReIND
# Admins (Komma-getrennt): dürfen unter „Zugang“ Partner freischalten und WhatsApp koppeln
ADMIN_EMAILS=

# ── WhatsApp ────────────────────────────────────────────────────────────────
# Nur diese Gruppe(n) werden gespeichert (Name wie in WhatsApp, Komma-getrennt)
WA_GRUPPEN=Objekte Immo

# ── Claude ──────────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=64000
CLAUDE_FALLBACKS=on
WEB_SEARCH_MAX_USES=20
WEB_FETCH_MAX_USES=15

# ── Sprachnachrichten ───────────────────────────────────────────────────────
# Standard: lokales Whisper im Docker-Netz (nichts eintragen). Alternativ Groq:
# TRANSCRIBE_URL=https://api.groq.com/openai/v1/audio/transcriptions
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ── Optional ────────────────────────────────────────────────────────────────
# FIXFLIP_DIR=/fixflip-pro
MAX_UPLOAD_MB=300

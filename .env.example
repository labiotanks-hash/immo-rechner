# ── Pflicht ─────────────────────────────────────────────────────────────────
# Schlüssel aus console.anthropic.com → API Keys (nie ins Repo!)
ANTHROPIC_API_KEY=
# Team-Passwort für die Web-App
APP_PASSWORD=
# Zufallswert für die Anmelde-Cookies: openssl rand -hex 32
SESSION_SECRET=
# Subdomain, auf der die App läuft (DNS A-Record auf den Server)
DOMAIN=rechner.a2o-architekten.de
PUBLIC_URL=https://rechner.a2o-architekten.de

# ── Claude ──────────────────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max — high ist der Standard
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=64000
# Bei Ablehnung durch einen Sicherheitsfilter serverseitig auf das empfohlene Ersatzmodell ausweichen (on/off)
CLAUDE_FALLBACKS=on
WEB_SEARCH_MAX_USES=20
WEB_FETCH_MAX_USES=15

# ── Sprachnachrichten (Whisper-kompatibler Endpunkt) ─────────────────────────
# Groq (whisper-large-v3-turbo, dasselbe Modell wie lokal auf dem Mac):
TRANSCRIBE_URL=https://api.groq.com/openai/v1/audio/transcriptions
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Alternativ OpenAI: TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions, TRANSCRIBE_MODEL=whisper-1

# ── Optional ────────────────────────────────────────────────────────────────
# Ordner mit eurer FixFlip Pro (index.html + standalone/build.py), siehe docker-compose.yml
# FIXFLIP_DIR=/fixflip-pro
MAX_UPLOAD_MB=300
